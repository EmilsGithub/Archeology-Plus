{
	"schemaVersion": 1,
	"id": "archeologyplus",
	"version": "${version}",
	"name": "Archeology Plus",
	"description": "A 1.20+ mod that adds to the Archeology feature, while also adding Structures, Items, Blocks, etc. related to it.",
	"authors": [
		"EmilSG"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/archeology-plus",
		"issues": "https://github.com/EmilsGithub/Archeology-Plus/issues",
		"sources": "https://github.com/EmilsGithub/Archeology-Plus"
	},
	"custom": {
		"modmenu": {
			"links": {
				"Discord": "https://discord.gg/pDMkMxMREA"
			},
			"update_checker": true
		}
	},
	"license": "MIT",
	"icon": "assets/archeologyplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.emilsg.archeologyplus.ArcheologyPlus"
		],
		"client": [
			"net.emilsg.archeologyplus.ArcheologyPlusClient"
		],
		"fabric-datagen": [
			"net.emilsg.archeologyplus.ArcheologyPlusDataGenerator"
		]
	},
	"mixins": [
		"archeologyplus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": [
			"1.20",
			"1.20.1"
		],
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}